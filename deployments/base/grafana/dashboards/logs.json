          "editorMode": "code",
          "expr": "hostname:$host app_name:$app kubernetes.pod_namespace:$namespace kubernetes.pod_name:$pod kubernetes.container_name:$container level:$level $search hostname:* | stats by (hostname) count() as lines | sort by (lines desc) | limit 15",
          "queryType": "stats",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": ["lastNotNull"],
            "includeTimeField": false,
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true,
              "__name__": true
            },
            "indexByName": {
              "hostname": 0,
              "Last *": 1
            },
            "renameByName": {
              "Last *": "Lines",
              "hostname": "Host"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
