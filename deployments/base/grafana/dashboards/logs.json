        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "hostname:~`^${host:regex}$` app_name:~`^${app:regex}$` kubernetes.pod_namespace:~`^${namespace:regex}$` kubernetes.pod_name:~`^${pod:regex}$` kubernetes.container_name:~`^${container:regex}$` level:~`^${level:regex}$` $search hostname:* | stats by (hostname) count() as lines | sort by (lines desc) | limit 15",
          "queryType": "stats",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": ["lastNotNull"],
            "includeTimeField": false,
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true,
              "__name__": true
            },
            "indexByName": {
              "hostname": 0,
              "Last *": 1
            },
            "renameByName": {
              "Last *": "Lines",
              "hostname": "Host"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
