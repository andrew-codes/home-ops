{
  "name": "pihole",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "targets": {
    "clean/provision": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .terraform src/.terraform* src/provision/terraform* src/provision/.terraform* src/provision/terraform.plan ",
        "cwd": "{projectRoot}"
      }
    },
    "provision": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "module": "scripts/provision.ts",
        "cwd": "{projectRoot}"
      }
    },
    "update": {
      "executor": "@ha/nx-executors:invoke",
      "dependsOn": ["^prepare", "prepare"],
      "options": {
        "module": "scripts/update.ts",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "module": "scripts/deploy.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.test-runs/unit"],
      "options": {
        "command": "jest",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ansible-playbook --syntax-check --inventory localhost, src/dns-records/index.yml",
          "ansible-playbook --syntax-check --inventory localhost, src/dns-records-list/index.yml"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "dns-records": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "module": "scripts/dns-records.ts",
        "cwd": "{projectRoot}"
      }
    },
    "list-dns-records": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "module": "scripts/list-dns-records.ts",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [],
  "implicitDependencies": []
}
