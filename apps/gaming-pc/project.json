{
  "name": "gaming-pc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/gaming-pc",
  "projectType": "application",
  "targets": {
    "pre-deploy": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "cwd": "{projectRoot}",
        "module": "scripts/pre-deploy.ts"
      }
    },
    "deploy": {
      "executor": "@ha/nx-executors:invoke",
      "dependsOn": ["^prepare", "prepare", "^deploy"],
      "options": {
        "cwd": "{projectRoot}",
        "module": "scripts/deploy.ts"
      }
    },
    "publish": {
      "executor": "@ha/nx-executors:invoke",
      "options": {
        "cwd": "{projectRoot}",
        "module": "scripts/publish-github-release.ts"
      }
    }
  },
  "tags": [],
  "implicitDependencies": []
}
